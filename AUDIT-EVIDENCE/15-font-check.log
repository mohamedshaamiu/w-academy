--- full app.css ---
@tailwind base;
@tailwind components;
@tailwind utilities;

@font-face {
    font-family: 'MV Boli';
    src: url('../fonts/MVBoli.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

.font-thaana {
    font-family: 'MV Boli', 'Faruma', sans-serif;
}

html[dir='rtl'] body {
    font-family: 'MV Boli', 'Faruma', sans-serif;
}

--- tailwind.config.js ---
import forms from '@tailwindcss/forms';

/** @type {import('tailwindcss').Config} */
export default {
    content: [
        './vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php',
        './storage/framework/views/*.php',
        './resources/views/**/*.blade.php',
    ],

    theme: {
        extend: {
            fontFamily: {
                sans: ['MV Boli', 'Faruma', 'system-ui', 'sans-serif'],
            },
            colors: {
                navy: {
                    DEFAULT: '#0B1F3A',
                    50: '#EBEEF3',
                    100: '#D1D9E4',
                    200: '#A3B3C9',
